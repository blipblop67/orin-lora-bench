# ---------------------------------------------------------------------------
# orin-lora-bench configuration (sourced by every script).
# Copy to config.local.env and override there; config.local.env wins.
# Target: Jetson Orin Nano (8 GB) / Orin Nano Super, JetPack 6.2 (L4T r36.4.x, CUDA 12.6)
# ---------------------------------------------------------------------------

# ---- Model / data ----------------------------------------------------------
BASE_MODEL="Qwen/Qwen2.5-1.5B-Instruct"      # model that gets fine-tuned and served
DATASET_PRESET="sql"                         # sql (gretelai/synthetic_text_to_sql) | alpaca
TRAIN_SAMPLES=2000
EVAL_SAMPLES=200                             # held-out examples for eval loss / task accuracy

# ---- Training --------------------------------------------------------------
# Training sweep: one run per entry, "model|mode|max_seq_len|max_steps"
# mode = lora (bf16 base) | qlora (4-bit NF4 base via bitsandbytes)
TRAIN_MATRIX=(
  "Qwen/Qwen2.5-0.5B-Instruct|lora|512|300"
  "Qwen/Qwen2.5-1.5B-Instruct|lora|512|300"
  "Qwen/Qwen2.5-1.5B-Instruct|qlora|512|300"
  "Qwen/Qwen2.5-1.5B-Instruct|qlora|1024|300"
)
# Which training run's adapter gets exported and served (directory name under outputs/train/)
SERVE_RUN="Qwen2.5-1.5B-Instruct_qlora_s512"
LORA_RANK=16
LORA_ALPHA=32
LR=2e-4
BATCH=2
GRAD_ACCUM=8

# ---- Containers (JetPack 6 = "older Orin" path) ---------------------------
LLAMA_CPP_IMAGE="ghcr.io/nvidia-ai-iot/llama_cpp:latest-jetson-orin"
VLLM_IMAGE="ghcr.io/nvidia-ai-iot/vllm:latest-jetson-orin"
# Set to a directory containing llama-server/llama-bench/... to use a native build instead of docker
LLAMA_CPP_BIN_DIR=""
# llama.cpp source checkout used only for the Python GGUF converters (pin a tag for reproducibility)
LLAMA_CPP_REF="master"
HF_CACHE="${HOME}/.cache/huggingface"

# Jetson AI Lab pip index matching JetPack 6.2 / CUDA 12.6
JETSON_PIP_INDEX="https://pypi.jetson-ai-lab.io/jp6/cu126/+simple/"

# ---- Quantisation ----------------------------------------------------------
GGUF_QUANTS=(Q8_0 Q6_K Q5_K_M Q4_K_M Q4_0)   # F16 is always produced and benchmarked too

# ---- llama.cpp benchmark ---------------------------------------------------
LCPP_PORT=8080
LCPP_BENCH_DEPTHS="0,2048,8192"              # llama-bench -d (tg/pp measured at this KV depth), if supported
LCPP_CTX_LIST=(2048 4096 8192 16384 32768)   # context sizes for the memory-fit matrix
LCPP_KV_TYPES=(f16 q8_0 q4_0)                # KV-cache types for the fit matrix
FIT_PROBE_MAX_CTX=16384                      # send a ~90%-of-ctx prompt to verify long prefill up to this ctx
PPL_CHUNKS=64

# ---- vLLM benchmark --------------------------------------------------------
VLLM_PORT=8000
VLLM_MAX_LENS=(2048 4096 8192 16384)
VLLM_GPU_UTILS=(0.45 0.60 0.75)              # fraction of *total unified memory* on Jetson
VLLM_BENCH_MAX_LEN=4096                      # config used for the throughput / accuracy runs
VLLM_BENCH_GPU_UTIL=0.60
VLLM_EXTRA_ARGS="--max-num-seqs 8"           # e.g. add --enforce-eager to skip CUDA-graph capture
VLLM_STARTUP_TIMEOUT=900

# ---- Serving benchmark (shared by both runtimes) --------------------------
BENCH_INPUT_LEN=512
BENCH_OUTPUT_LEN=128
BENCH_CONCURRENCY="1,2,4,8"
BENCH_NUM_PROMPTS=24
LCPP_PARALLEL=4                              # llama-server -np slots for the serving bench

# Drop page cache between fit-test configs (needs passwordless sudo for `tee /proc/sys/vm/drop_caches`)
DROP_CACHES=0
